# Server-side settings only. The access token is never bundled into browser code.
# If the adjacent evo-backend/.env exists, its BACKEND_WEB_TOKEN is reused.
BACKEND_URL=http://127.0.0.1:3000
BACKEND_WEB_TOKEN=
# ASR uses the same backend proxy. Configure BACKEND_ASR_API_KEY only in evo-backend/.env.
